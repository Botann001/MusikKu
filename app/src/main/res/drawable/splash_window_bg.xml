<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Solid dark emerald background, matching the app theme -->
    <item>
        <color android:color="#0B130E" />
    </item>
    <!-- Centered foreground icon with fixed dimensions so it NEVER distorts or stretches -->
